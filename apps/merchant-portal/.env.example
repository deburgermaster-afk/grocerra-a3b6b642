# Next.js web app. Only NEXT_PUBLIC_* values reach the browser; they must be public-safe.
# Never put secret keys (Stripe secret, Supabase secret, courier keys) here: they belong to services/api.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
