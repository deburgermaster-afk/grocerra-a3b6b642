# NestJS API + job worker (services/api). SERVER-SIDE ONLY.
# Real values live in Reevake › Project secrets and as Cloudflare Worker secrets. Never commit them.

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Database (Postgres) ---
# Production: Supabase (Sydney, ap-southeast-2). On Cloudflare the API reaches it
# through the Hyperdrive binding HYPERDRIVE; DATABASE_URL is for local runs and migrations.
# Development / task branches: a Neon branch (Sydney) issued per task by ReevTask
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# Direct (session) connection for migrations, port 5432
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Supabase (auth, storage, realtime) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Payments: Stripe Connect ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# --- Delivery: Uber Direct ---
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_WEBHOOK_SECRET=

# --- Delivery: DoorDash Drive ---
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_WEBHOOK_SECRET=

# --- Maps (server-side geocoding / distance) ---
GOOGLE_MAPS_SERVER_KEY=

# --- Notifications ---
FCM_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=re_...
EMAIL_FROM=Sogrow <no-reply@example.com>

# --- Monitoring ---
SENTRY_DSN=
